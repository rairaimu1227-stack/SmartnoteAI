<Window x:Class="SmartNote.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="SmartNote AI — PoC v0.1.1" Width="1200" Height="800" MinWidth="850" MinHeight="550" Topmost="{Binding Topmost}" Background="#F4F6FA" WindowStyle="None" ResizeMode="CanResize">
<shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0"/></shell:WindowChrome.WindowChrome>
<DockPanel><Border DockPanel.Dock="Top" Background="#23364D" Height="40"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Button Content="{Binding PinLabel}" Click="PinClick" Padding="12,4"/><Button Content="─" Click="MinimizeClick" Width="42"/><Button Content="□" Click="MaximizeClick" Width="42"/><Button Content="×" Click="HideClick" Width="42"/></StackPanel><TextBlock Foreground="White" Margin="14,9" Text="SmartNote AI / 技術検証版"/></DockPanel></Border><StatusBar DockPanel.Dock="Bottom"><TextBlock Text="{Binding Status}" TextWrapping="Wrap"/></StatusBar><Grid><wv:WebView2 x:Name="Web"/><Border x:Name="FailurePanel" Background="#FFF1EB" Visibility="Collapsed" VerticalAlignment="Top" Padding="18"><StackPanel><TextBlock x:Name="FailureText" TextWrapping="Wrap" Foreground="#9B2424"/><Button Content="保存済みデータからエディタを再起動（未保存内容は失われます）" Click="RecoverClick" HorizontalAlignment="Left" Margin="0,10,0,0"/></StackPanel></Border></Grid></DockPanel></Window>
